# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
build/
dist/

# Virtual environment
.venv/
venv/

# Local models, data, vector DBs (not source code)
models/
*.db
*.sqlite
*.sqlite3

# Per-project TUI state: chat preferences and saved conversations.
.ovat/

# OS / editor cruft
.DS_Store
.vscode/
.idea/

# Personal Claude Code bridge to AGENTS.md: not shared, per-machine.
CLAUDE.local.md

# OVMS process logs
*.log

# OVMS pidfile written by `ovat serve` (read back by `ovat serve --stop`).
# Machine-local runtime state: never the same on two boxes.
*.pid

# Measurement artifacts: `ovat bench --out` reports and `ovat run --trace`
# traces. Real numbers, but they belong to ONE run on ONE machine, so they are
# evidence to paste into a write-up, not source to track.
report*.json
trace*.json

# A workflow.yml written by `ovat init` in the repo root is local scratch; the
# canonical sample lives in examples/. The leading slash ignores ONLY the root
# one, so examples/workflow.yml stays tracked.
/workflow.yml

# Review artifacts written by external tools, not part of the toolkit.
/analysis_report.md

# Agent worktrees and session scratch: never part of the project.
.claude/worktrees/
